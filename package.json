{
  "name": "stream-deck-copy-reference",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:native && rollup -c",
    "build:native": "node scripts/build-native.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "validate": "streamdeck validate dev.vicky.copyreference.sdPlugin",
